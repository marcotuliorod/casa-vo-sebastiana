# ============================================================
# Casa de Vó Sebastiana — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# ─── Autenticação (Auth.js — substitui o Supabase Auth) ────────
# AUTH_SECRET: gere com `npx auth secret` ou `openssl rand -hex 32`
# RESEND_API_KEY: resend.com → API Keys
# AUTH_EMAIL_FROM: remetente do magic link. O domínio do endereço PRECISA estar
# verificado no Resend (resend.com → Domains); com domínio não verificado o
# Resend recusa o envio e ninguém consegue fazer login.
# AUTH_URL: URL pública do site (mesmo domínio de DOMAIN, com https://). Sem
# isso o Auth.js pode construir links (ex: redirect de erro do magic link)
# usando o endereço interno do container em vez do domínio público — a
# detecção automática via header por trás do proxy (Traefik/Caddy) não é confiável o
# bastante sozinha (validado rodando o Compose completo).
AUTH_SECRET=
AUTH_URL=https://localhost
RESEND_API_KEY=re_...
AUTH_EMAIL_FROM=Casa de Vó Sebastiana <login@seudominio.com.br>

# ─── Docker Compose (self-hosted) ──────────────────────────────
# Usadas pelo docker-compose.yml para subir Postgres + app + proxy + cron + backup.

POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=casa_vo_sebastiana
# ATENÇÃO: a senha aqui precisa ser IDÊNTICA a POSTGRES_PASSWORD acima.
# docker-compose.yml usa env_file (não `environment: ${VAR}`) para o serviço
# `app`, que não faz substituição de variável — as duas linhas não se
# sincronizam sozinhas. Esquecer de igualar as duas dá erro de
# "password authentication failed" só em runtime, não no build.
DATABASE_URL=postgres://app:CHANGE_ME@postgres:5432/casa_vo_sebastiana

# Domínio público do site (TLS automático via Let's Encrypt).
# Para testes locais, deixe "localhost" — o Caddy usa um certificado local automático.
DOMAIN=localhost

# Proxy reverso. Produção (VPS com Traefik já ocupando 80/443): descomente a
# linha abaixo — desativa o Caddy e publica o app por labels do Traefik.
# Sem ela, o Compose sobe o Caddy (opção para servidor dedicado / testes locais).
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml

# ─── E-mails para consulentes, médiuns e a Casa ───────────────
# Enviados pelo Resend (mesma RESEND_API_KEY do login).
# EMAIL_FROM: remetente. O domínio PRECISA estar verificado no Resend
# (resend.com → Domains). Com onboarding@resend.dev o Resend só entrega
# para o e-mail do dono da conta. Se vazio, usa AUTH_EMAIL_FROM.
# EMAIL_REPLY_TO (opcional): para onde vão as respostas dos consulentes.
EMAIL_FROM=Casa de Vó Sebastiana <contato@seudominio.com.br>
EMAIL_REPLY_TO=

# ─── Segurança do Cron ────────────────────────────────────────
# Gere com: openssl rand -hex 32
# OBRIGATÓRIO — mínimo 32 caracteres. Cron retorna 500 se não configurado.
CRON_SECRET=

# ─── Acesso Admin ─────────────────────────────────────────────
# Lista de emails autorizados a acessar o painel admin (separados por vírgula)
# Se vazio, qualquer usuário autenticado tem acesso
# Exemplo: admin@seudominio.com,outroAdmin@seudominio.com
ADMIN_EMAILS=

# ─── Avisos à Casa ────────────────────────────────────────────
# E-mails que recebem avisos de novos agendamentos, inscrições e cancelamentos
# (separados por vírgula). Deixar vazio para desativar.
ADMIN_EMAIL_NOTIFICACOES=

# ─── App ──────────────────────────────────────────────────────
# URL base para os links nos e-mails
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Em produção:
# NEXT_PUBLIC_BASE_URL=https://agenda.mtrm.tech
