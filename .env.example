# ============================================================
# Casa de Vó Sebastiana — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# ─── Supabase ─────────────────────────────────────────────────
# Encontre em: supabase.com → seu projeto → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Docker Compose (self-hosted) ──────────────────────────────
# Usadas pelo docker-compose.yml para subir Postgres + app + proxy + cron + backup.
# A aplicação ainda lê as variáveis do Supabase acima até a migração de código ser concluída;
# estas variáveis preparam a infraestrutura Postgres que vai substituí-las.

POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=casa_vo_sebastiana
DATABASE_URL=postgres://app:CHANGE_ME@postgres:5432/casa_vo_sebastiana

# Domínio público servido pelo proxy Caddy (TLS automático via Let's Encrypt).
# Para testes locais, deixe "localhost" — o Caddy usa um certificado local automático.
DOMAIN=localhost

# ─── WhatsApp ─────────────────────────────────────────────────
# Escolha um provedor: 'zapi' ou 'twilio'

WHATSAPP_PROVIDER=zapi

# --- Z-API (https://app.z-api.io) ---
# Crie uma instância gratuita e copie os dados abaixo:
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Twilio (https://console.twilio.com) ---
# Ative o sandbox WhatsApp em: Messaging → Try it Out → Send a WhatsApp message
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# ─── Segurança do Cron ────────────────────────────────────────
# Gere com: openssl rand -hex 32
# OBRIGATÓRIO — mínimo 32 caracteres. Cron retorna 500 se não configurado.
CRON_SECRET=

# ─── Acesso Admin ─────────────────────────────────────────────
# Lista de emails autorizados a acessar o painel admin (separados por vírgula)
# Se vazio, qualquer usuário autenticado tem acesso
# Exemplo: admin@seudominio.com,outroAdmin@seudominio.com
ADMIN_EMAILS=

# ─── Notificações ─────────────────────────────────────────────
# Número WhatsApp da admin para receber notificações de novos agendamentos
# Formato E.164 sem +: ex. 5511999999999
# Deixar vazio para desabilitar notificações para admin
ADMIN_WHATSAPP=

# ─── App ──────────────────────────────────────────────────────
# URL base para links nas mensagens WhatsApp
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Em produção:
# NEXT_PUBLIC_BASE_URL=https://casavosebastiana.com.br
